{
  "manifest_version": 3,
  "name": "Live Lab — Diretta Watch",
  "version": "0.5.1",
  "description": "Monitora Diretta.it e alimenta il Live Lab Strategy Radar: Goal Pressure, Late Goal, Equalizer e Favorite Push, con icone dedicate, Forebet Gate e Telegram.",
  "permissions": ["storage","notifications","tabs","scripting"],
  "host_permissions": ["https://www.diretta.it/*","https://diretta.it/*","https://api.telegram.org/*","https://*/*"],
  "background": {"service_worker":"background.js","type":"module"},
  "action": {"default_popup":"popup.html","default_title":"Live Lab"},
  "content_scripts": [{"matches":["https://www.diretta.it/*","https://diretta.it/*"],"js":["content.js"],"run_at":"document_idle"}],
  "icons": {"16":"icons/icon16.png","32":"icons/icon32.png","48":"icons/icon48.png","128":"icons/icon128.png"}
}
